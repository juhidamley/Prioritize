{
  "rewrites": [
    {
      "source": "/prioritize",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/:path*",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/lecturetex/api/:path*",
      "destination": "/api/lecturetex/:path*"
    },
    {
      "source": "/lecturetex",
      "destination": "/lecturetex/index.html"
    },
    {
      "source": "/lecturetex/",
      "destination": "/lecturetex/index.html"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}