{
  "rewrites": [
    {
      "source": "/prioritize",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/:path*",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}