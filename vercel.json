{
  "rewrites": [
    {
      "source": "/prioritize",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/prioritize/:path*",
      "destination": "/ptz/index.html"
    },
    {
      "source": "/lecturetex/api/:path*",
      "destination": "https://lecturetex-juhidamleys-projects.vercel.app/lecturetex/api/:path*"
    },
    {
      "source": "/lecturetex/:path*",
      "destination": "https://lecturetex-juhidamleys-projects.vercel.app/lecturetex/:path*"
    },
    {
      "source": "/lecturetex",
      "destination": "https://lecturetex-juhidamleys-projects.vercel.app/lecturetex"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}